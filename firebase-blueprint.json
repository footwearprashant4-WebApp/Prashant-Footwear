{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Footwear product stored in inventory.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["Men", "Women", "Kids"] },
        "subCategory": { "type": "string", "enum": ["Office Wear", "Sandals", "Casuals", "Shoes", "Others"] },
        "sizes": { "type": "array" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "stock": { "type": "number" },
        "barcode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "category", "subCategory", "sizes", "price", "stock", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile with mobile and role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "mobile": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "customer"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "mobile", "role", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrators list.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "mobile": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["uid", "mobile"]
    },
    "Order": {
      "title": "Order",
      "description": "Sales orders and bills generated by the billing workspace.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerMobile": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["completed", "pending"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerMobile", "items", "totalAmount", "status", "createdAt"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Application settings and configurations.",
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["url"]
    },
    "HeroVideo": {
      "title": "HeroVideo",
      "description": "Custom videos for the cinematic hero banner playlist.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isBase64": { "type": "boolean" }
      },
      "required": ["id", "name", "url", "createdAt"]
    },
    "HeroImage": {
      "title": "HeroImage",
      "description": "Custom images for the hero banner slideshow.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isBase64": { "type": "boolean" }
      },
      "required": ["id", "name", "url", "createdAt"]
    },
    "StockLedger": {
      "title": "StockLedger",
      "description": "Stock ledger invoices tracking inward goods additions and historical stock entry logs.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "items": { "type": "array" },
        "totalUnits": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "draft"] },
        "notes": { "type": "string" },
        "operatorMobile": { "type": "string" }
      },
      "required": ["id", "createdAt", "items", "totalUnits", "status"]
    },
    "BrandConfig": {
      "title": "BrandConfig",
      "description": "Footwear brand configuration including 100x100 logo, 350x150 banner, theme colors, and partner status.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "brandName": { "type": "string" },
        "tagline": { "type": "string" },
        "description": { "type": "string" },
        "logoUrl": { "type": "string" },
        "bannerUrl": { "type": "string" },
        "accentColor": { "type": "string" },
        "displayMediaType": { "type": "string", "enum": ["banner", "video", "none"] },
        "videoUrl": { "type": "string" },
        "isVerifiedPartner": { "type": "boolean" },
        "trustBadges": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "brandName", "createdAt"]
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": "Product",
      "description": "Footwear catalog items."
    },
    "users/{userId}": {
      "schema": "User",
      "description": "Registered customer and admin profiles."
    },
    "admins/{adminId}": {
      "schema": "Admin",
      "description": "List of user UIDs authorized for admin operations."
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Historic sales orders and billing records."
    },
    "settings/{settingId}": {
      "schema": "Setting",
      "description": "Global application configuration settings."
    },
    "hero_videos/{videoId}": {
      "schema": "HeroVideo",
      "description": "Cinematic banner background loop videos (max 4)."
    },
    "hero_images/{imageId}": {
      "schema": "HeroImage",
      "description": "Cinematic banner background slideshow images (max 4)."
    },
    "stock_ledgers/{ledgerId}": {
      "schema": "StockLedger",
      "description": "Historical inward goods ledgers."
    },
    "brand_configs/{brandId}": {
      "schema": "BrandConfig",
      "description": "Brand identities, 100x100 logos, and 350x150 banners."
    }
  }
}
